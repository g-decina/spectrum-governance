# Spectrum Governance Configuration
# Copy this file to .env and customize as needed

# ===================================================================
# OpenLineage Configuration
# ===================================================================

# OpenLineage backend URL (Marquez or other compatible backend)
# Default: http://localhost:5000
OPENLINEAGE_URL=http://localhost:5000

# Namespace for all lineage events
# Default: spectrum.governance
# Use different namespaces for different environments (dev, staging, prod)
OPENLINEAGE_NAMESPACE=spectrum.governance

# Enable/disable lineage tracking
# Default: true
# Set to "false" to disable tracking in development/testing
OPENLINEAGE_ENABLED=true

# ===================================================================
# Application Configuration
# ===================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ===================================================================
# Production Settings (when deploying Marquez remotely)
# ===================================================================

# For production, point to your hosted Marquez instance:
# OPENLINEAGE_URL=https://marquez.yourcompany.com
# OPENLINEAGE_NAMESPACE=production

# If your Marquez instance requires authentication:
# OPENLINEAGE_API_KEY=your-api-key-here
# (Note: You'll need to modify the client initialization to use API keys)
